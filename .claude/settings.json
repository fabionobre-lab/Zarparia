{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"House rule (Fabio, 2026-08-17): load the /simple-english skill (simple-english:simple-english, STE pragmatic mode) with the Skill tool before you write any reply to Fabio or any user-facing app copy. Its rules bind all session output.\"},\"suppressOutput\":true}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix web test || exit 2",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "Running vitest suite before stopping..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm --prefix web run *)",
      "Bash(npm --prefix web test)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(npm run deploy)"
    ]
  }
}
